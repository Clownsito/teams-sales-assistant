# Servidor
PORT=3000

# Base de datos (config de tenants, snapshots)
DB_HOST=localhost
DB_PORT=3307
DB_USER=teams_assistant
DB_PASSWORD=change-me
DB_NAME=teams_sales_assistant

# Cache
CACHE_TTL_SECONDS=300

# Bot Framework (Microsoft Teams)
# Dejar TEAMS_APP_ID / TEAMS_APP_PASSWORD vacíos para probar en local con el
# Bot Framework Emulator (el adaptador corre en modo anónimo). Se completan
# con los valores del App Registration al integrar Teams real.
# TEAMS_APP_TYPE / TEAMS_APP_TENANT_ID: solo para Azure real y solo si el App
# Registration es SingleTenant o UserAssignedMsi. Con MultiTenant van vacíos.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TYPE=
TEAMS_APP_TENANT_ID=

# Fallback con IA (opcional). Sin ANTHROPIC_API_KEY, las preguntas fuera de los
# patrones conocidos siguen respondiendo el mensaje de ayuda fijo (ADR-005).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Solo si la API key está asociada a un workspace (formato wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Búsqueda web para preguntas de mercado/competencia (ADR-006). Tiene costo
# aparte (~US$10 cada 1000 búsquedas). Poné 0/false/off para desactivarla.
ANTHROPIC_WEB_SEARCH=on
