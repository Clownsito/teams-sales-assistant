# Servidor
PORT=3000

# Base de datos (config de tenants, snapshots)
DB_HOST=localhost
DB_PORT=3307
DB_USER=teams_assistant
DB_PASSWORD=change-me
DB_NAME=teams_sales_assistant

# Cache
CACHE_TTL_SECONDS=300

# Bot Framework (Microsoft Teams)
# Dejar TEAMS_APP_ID / TEAMS_APP_PASSWORD vacíos para probar en local con el
# Bot Framework Emulator (el adaptador corre en modo anónimo). Se completan
# con los valores del App Registration al integrar Teams real.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TYPE=MultiTenant
TEAMS_APP_TENANT_ID=
